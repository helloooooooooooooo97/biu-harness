{
  "plugins": [
    {
      "id": "greeter",
      "name": "问候服务",
      "layer": "capability",
      "blurb": "独立包：@hmr/greeter-host + @hmr/greeter-ui（cordis.plugins.json 引入）。",
      "package": "@hmr/greeter-host",
      "ui": "@hmr/greeter-ui",
      "togglable": true,
      "enabled": true
    },
    {
      "id": "tasks",
      "name": "任务",
      "layer": "capability",
      "blurb": "独立包：@hmr/tasks-host + @hmr/tasks-ui。Table/Board + SQLite + Agent tools。",
      "package": "@hmr/tasks-host",
      "ui": "@hmr/tasks-ui",
      "togglable": true,
      "enabled": true
    },
    {
      "id": "channels",
      "name": "频道",
      "layer": "capability",
      "blurb": "独立包：@hmr/channel-host + @hmr/channel-ui。内网分布式群聊：有序消息流 + 成员 + 邀请。",
      "package": "@hmr/channel-host",
      "ui": "@hmr/channel-ui",
      "togglable": true,
      "enabled": true
    }
  ]
}
