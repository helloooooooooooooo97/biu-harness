{
  "name": "hmr-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/link-cordis-plugins.mjs",
    "predev": "node scripts/link-cordis-plugins.mjs",
    "prestart": "node scripts/link-cordis-plugins.mjs",
    "dev": "concurrently -k \"npm:dev:host\" \"npm:dev:web\"",
    "dev:host": "tsx watch host/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx host/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "antd": "^6.6.1",
    "cordis": "4.0.0-rc.8",
    "dompurify": "^3.4.14",
    "marked": "^18.0.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "ws": "^8.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.11"
  }
}
