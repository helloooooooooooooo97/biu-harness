{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug current test file",
            "runtimeExecutable": "${fileDirname}/node_modules/.bin/tsx",
            "runtimeArgs": ["--test"],
            "args": ["${file}"],
            "cwd": "${fileDirname}",
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug current file",
            "runtimeExecutable": "${fileDirname}/node_modules/.bin/tsx",
            "args": ["${file}"],
            "cwd": "${fileDirname}",
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal"
        }
    ]
}
